{
  "name": "@gallerai/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/api/gallerai/api.gen.ts",
    "./worker": "./src/api/worker/worker.gen.ts",
    "./schemas": "./src/api/schemas/index.ts",
    "./schemas/*": "./src/api/schemas/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "web": [
        "./src/api/gallerai/api.gen.ts"
      ],
      "worker": [
        "./src/api/worker/worker.gen.ts"
      ],
      "schemas": [
        "./src/api/schemas/index.ts"
      ],
      "schemas/*": [
        "./src/api/schemas/*.ts"
      ],
      "lib/*": [
        "./src/lib/*.ts"
      ]
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0"
  }
}
